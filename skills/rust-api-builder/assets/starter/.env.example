APP_PORT=8000
RUST_LOG=info,actix_web=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/rust_api_starter
DATABASE_POOL_SIZE=5

REDIS_URL=redis://localhost:6379/0

# only for routes that use JwtMiddleware (not authenticated by the API gateway):
# `n` and `e` of the issuer's JWKS signing key, and the expected `aud` (empty = not checked)
JWKS_N=
JWKS_E=AQAB
JWT_AUDIENCE=
